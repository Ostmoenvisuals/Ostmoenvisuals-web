---
/* Lite video-embed: stillbilde og play-knapp, spilleren lastes først ved klikk.
   Uten youtubeId lenker knappen til fallbackHref (til video-id er avklart). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  poster: ImageMetadata;
  alt: string;
  title: string;
  youtubeId?: string;
  fallbackHref?: string;
}
const { poster, alt, title, youtubeId, fallbackHref = 'https://www.youtube.com/@stmoenvisuals2221/videos' } = Astro.props;
---
<div class="video" data-youtube-id={youtubeId} data-title={title}>
  <Image class="video__poster" src={poster} alt={alt} widths={[600, 900, 1200, 1800]} sizes="(min-width: 900px) 1200px, 100vw" />
  {youtubeId ? (
    <button class="video__play" type="button" aria-label={`Spill av: ${title}`}><span class="video__icon" aria-hidden="true"></span></button>
  ) : (
    <a class="video__play" href={fallbackHref} target="_blank" rel="noopener" aria-label={`Se: ${title} (åpner YouTube i ny fane)`}><span class="video__icon" aria-hidden="true"></span></a>
  )}
</div>

<style>
  .video { position: relative; aspect-ratio: 16 / 9; border-radius: var(--radius-lg); overflow: hidden; background: var(--surface-raised); }
  .video :global(.video__poster), .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
  .video__play { position: absolute; inset: 0; display: grid; place-items: center; background: none; border: 0; cursor: pointer; }
  .video__icon { width: 72px; height: 72px; border-radius: var(--radius-pill); background: var(--accent); transition: filter var(--dur-hover) ease; position: relative; }
  .video__icon::after { content: ''; position: absolute; left: 29px; top: 22px; border-left: 20px solid var(--on-accent); border-top: 14px solid transparent; border-bottom: 14px solid transparent; }
  .video__play:hover .video__icon { filter: brightness(0.92); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.video[data-youtube-id]').forEach((box) => {
    const id = box.dataset.youtubeId;
    const btn = box.querySelector('button');
    if (!id || !btn) return;
    btn.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = box.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      box.replaceChildren(iframe);
    });
  });
</script>
