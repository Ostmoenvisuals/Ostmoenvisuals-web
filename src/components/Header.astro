---
const path = Astro.url.pathname;
const links = [
  { href: '/video', label: 'Video' },
  { href: '/foto', label: 'Foto' },
  { href: '/prosjekter', label: 'Prosjekter' },
  { href: '/om-oss', label: 'Om oss' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__logo" href="/" aria-label="Østmoen Visuals, til forsiden">
      <img src="/logo/ostmoen_visuals_logo_black.svg" alt="Østmoen Visuals" width="566" height="253" />
    </a>

    <button class="site-header__toggle ov-btn ov-btn--outline ov-btn--sm" type="button" aria-expanded="false" aria-controls="hovedmeny">
      Meny
    </button>

    <nav class="site-header__nav" id="hovedmeny" aria-label="Hovedmeny">
      <ul class="site-header__list">
        {links.map((l) => (
          <li><a class="site-header__link label" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a class="ov-btn ov-btn--dark ov-btn--sm" href="/kontakt" aria-current={isCurrent('/kontakt') ? 'page' : undefined}>Kontakt</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { padding-block: var(--space-4); position: relative; z-index: 10; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .site-header__logo img { width: 112px; height: auto; }
  .site-header__toggle { display: none; }
  .site-header__list { display: flex; align-items: center; gap: var(--space-8); }
  .site-header__link { text-decoration: none; color: var(--ink); padding-block: var(--space-2); border-bottom: 2px solid transparent; transition: border-color var(--dur-hover) ease; }
  .site-header__link:hover { border-bottom-color: var(--line-strong); }
  .site-header__link[aria-current='page'] { border-bottom-color: var(--accent); }
  .ov-btn[aria-current='page'] { outline: 2px solid var(--accent); outline-offset: 2px; }

  @media (max-width: 799px) {
    :global(.js) .site-header__toggle { display: inline-flex; }
    :global(.js) .site-header__nav {
      display: none; position: absolute; left: var(--space-4); right: var(--space-4); top: 100%;
      background: var(--surface-raised); border-radius: var(--radius-md); padding: var(--space-4);
    }
    :global(.js) .site-header__nav.is-open { display: block; }
    .site-header__list { flex-direction: column; align-items: stretch; gap: var(--space-2); }
    .site-header__link { display: block; padding: var(--space-3) var(--space-2); }
    .site-header__list .ov-btn { width: 100%; margin-top: var(--space-2); }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.site-header__toggle');
  const nav = document.getElementById('hovedmeny');
  if (btn && nav) {
    const set = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      nav.classList.toggle('is-open', open);
    };
    btn.addEventListener('click', () => set(btn.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') set(false); });
  }
</script>
