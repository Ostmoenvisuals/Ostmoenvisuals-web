---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Video from '../components/Video.astro';
import btsKyst from '../assets/bilder/bts-kyst.webp';
import drone from '../assets/bilder/drone-solnedgang.webp';
import portrett from '../assets/bilder/portrett.webp';
import verksted from '../assets/bilder/verksted-snekker.webp';
import kaffe from '../assets/bilder/kaffe-barista.webp';
import interior from '../assets/bilder/interior-varm.webp';
import kyst from '../assets/bilder/kyst-solnedgang.webp';

const kunder = ['Nordnet', 'Biltema', 'Canon', 'Signify', 'Betonmast', 'Eske', 'Kaffepunkt', 'Sorbé', 'Kron', 'Fredensborg', 'RVM', 'Ditt Uterom', 'Grove Knutsen', 'Kaffeknappen', 'Abea', 'Drømmekjøkkenet'];

const tjenester = [
  { href: '/video', tittel: 'Video', tekst: 'Merkevarefilm, kursvideo, internfilm og korte annonser. Fra idé og manus til ferdig klipp i riktig format.' },
  { href: '/foto', tittel: 'Foto', tekst: 'Portretter, miljøbilder, interiør og event. Bilder i naturlig lys som viser folkene og stedet slik de er.' },
  { href: '/video/ai-teksting', tittel: 'AI-dubbing og teksting', tekst: 'Oversett, tekst og dubb videoene deres til flere språk, så de når flere uten nye opptak.' },
];

const prosjekter = [
  { href: '/prosjekter/troll-trevarefabrikk', tittel: 'Troll Trevarefabrikk', meta: 'Håndverk og produksjon', bilde: verksted, alt: 'Snekker ved arbeidsbenken i verkstedet hos Troll Trevarefabrikk' },
  { href: '/prosjekter/magnat-kaffehus', tittel: 'Magnat Kaffehus', meta: 'Miljøbilder · 2023', bilde: kaffe, alt: 'Barista som lager kaffe hos Magnat Kaffehus' },
  { href: '/prosjekter/eske-interior', tittel: 'Eske interiør', meta: 'Butikk og interiør', bilde: interior, alt: 'Varmt interiør i butikken til Eske interiør' },
  { href: '/prosjekter/fredensborg-fritid', tittel: 'Fredensborg Fritid', meta: 'Høstbilder', bilde: kyst, alt: 'Båt i havn i solnedgang, bilde for Fredensborg Fritid' },
];

const sitater = [
  { tekst: 'Vi har brukt Tobias til å lage promofilm for Kaffepunkt AS. Vi er ikke i tvil om hvem vi skal bruke neste gang!', av: 'Jakob Tangen', rolle: 'Kaffepunkt AS' },
  { tekst: 'Du er jo helt rå Tobias. Takk for at du har møtt opp på kort varsel og levert raskt.', av: 'Kristian Gjestemoen', rolle: 'Daglig leder, Betonmast Buskerud-Vestfold' },
  { tekst: 'Dyktigere kameramann og et så veldig fint menneske i tillegg – skal en lete lenge etter!', av: 'Ellen Harbo', rolle: 'Daglig leder, Sorbé' },
];
---
<Base
  title="Videoproduksjon i Drammen – Østmoen Visuals"
  description="Østmoen Visuals lager foto og video for bedrifter: merkevarefilm, kursvideo, internfilm og korte annonser. Vi holder til i Hokksund og tar oppdrag i hele Norge."
  ogImage={btsKyst}
>
  <!-- 2. Hero -->
  <section class="section section--hero">
    <div class="container hero">
      <div class="hero__text fade-in">
        <p class="ov-eyebrow">Foto og video · Drammen</p>
        <h1 class="display">Effektive foto- og videoproduksjoner.</h1>
        <p class="body-lg muted">Moderne og effektiv produksjon av innhold i alle formater, til alle kanaler. Merkevarefilm, kursvideo, internfilm og korte annonser.</p>
        <div class="hero__actions">
          <a class="ov-btn ov-btn--primary" href="/prosjekter">Se prosjekter</a>
          <a class="ov-btn ov-btn--outline" href="/kontakt">Priser og kontakt</a>
        </div>
      </div>
      <div class="hero__media fade-in">
        <Image src={btsKyst} alt="Fotograf i oransje vest som filmer ved sjøen" widths={[600, 900, 1200, 1800]} sizes="(min-width: 900px) 55vw, 100vw" loading="eager" fetchpriority="high" />
        <span class="ov-chip hero__chip">Bak kamera</span>
      </div>
    </div>
  </section>

  <!-- 3. Kundeliste -->
  <section class="kunder reveal" aria-labelledby="kunder-tittel">
    <div class="container">
      <div class="kunder__inner">
        <h2 id="kunder-tittel" class="label">Noen av våre kunder</h2>
        <ul class="kunder__list body-lg">
          {kunder.map((k) => <li>{k}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 4. Tjenester -->
  <section class="section" aria-labelledby="tjenester-tittel">
    <div class="container">
      <h2 id="tjenester-tittel" class="h1 reveal section-title">Innhold i alle formater, til alle kanaler.</h2>
      <ul class="tjenester">
        {tjenester.map((t) => (
          <li class="tjeneste reveal">
            <h3 class="h3">{t.tittel}</h3>
            <p class="body muted">{t.tekst}</p>
            <a class="text-link" href={t.href}>Les om {t.tittel.toLowerCase()} <span aria-hidden="true">→</span></a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 5. Utvalgte prosjekter -->
  <section class="section section--tight-top" aria-labelledby="prosjekter-tittel">
    <div class="container">
      <div class="section-head reveal">
        <div class="section-head__text">
          <p class="ov-eyebrow">Prosjekter</p>
          <h2 id="prosjekter-tittel" class="h1">Utvalgte prosjekter</h2>
        </div>
        <a class="ov-btn ov-btn--outline" href="/prosjekter">Se alle prosjekter</a>
      </div>
      <ul class="prosjekter">
        {prosjekter.map((p) => (
          <li class="reveal">
            <a class="ov-card" href={p.href}>
              <div class="ov-card__media">
                <Image src={p.bilde} alt={p.alt} widths={[400, 700, 1000]} sizes="(min-width: 700px) 45vw, 100vw" />
                <span class="ov-chip">Foto</span>
              </div>
              <div>
                <h3 class="ov-card__title">{p.tittel}</h3>
                <p class="ov-card__meta">{p.meta}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 6. Showreel: den ene Torv-seksjonen -->
  <section class="section section--tight-top" aria-labelledby="showreel-tittel">
    <div class="container">
      <div class="ov-section-torv showreel" data-theme="torv">
        <div class="showreel__head reveal">
          <p class="ov-eyebrow">Showreel</p>
          <h2 id="showreel-tittel" class="h1">Se hva vi har laget for andre.</h2>
          <a class="ov-btn ov-btn--primary" href="https://www.youtube.com/@stmoenvisuals2221/videos" target="_blank" rel="noopener">Spill av showreel<span class="sr-only"> (åpner YouTube i ny fane)</span></a>
        </div>
        <div class="reveal">
          <!-- TODO: legg inn youtubeId når showreelen er valgt. Da spilles den av her ved klikk. -->
          <Video poster={drone} alt="Dronebilde av kysten i solnedgang" title="Showreel fra Østmoen Visuals" />
        </div>
      </div>
    </div>
  </section>

  <!-- 7. Om oss -->
  <section class="section section--tight-top" aria-labelledby="om-tittel">
    <div class="container omoss">
      <div class="omoss__media reveal">
        <Image src={portrett} alt="Portrett av Tobias Østmoen" widths={[400, 600, 900]} sizes="(min-width: 900px) 40vw, 100vw" />
      </div>
      <div class="omoss__text reveal">
        <p class="ov-eyebrow">Om oss</p>
        <h2 id="om-tittel" class="h1">Bak kamera siden 2014.</h2>
        <p class="body-lg muted">Tobias Østmoen startet for seg selv i 2014 og har jobbet med foto og video på heltid siden 2016. I dag tar Østmoen Visuals oppdrag i hele Norge, de fleste i Oslo-området, og kombinerer innholdsproduksjon med kunnskap om netthandel og markedsføring.</p>
        <p class="caption">Godkjent lærlingbedrift</p>
        <a class="ov-btn ov-btn--outline" href="/om-oss">Mer om oss</a>
      </div>
    </div>
  </section>

  <!-- 8. Det kundene sier -->
  <section class="sitater-seksjon reveal" aria-labelledby="sitater-tittel">
    <div class="container">
      <div class="sitater-seksjon__inner">
        <h2 id="sitater-tittel" class="h2">Det kundene sier.</h2>
        <ul class="sitater">
          {sitater.map((s) => (
            <li>
              <figure>
                <blockquote class="body-lg">«{s.tekst}»</blockquote>
                <figcaption class="caption"><strong style="color: var(--ink)">{s.av}</strong> · {s.rolle}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 9. Kontakt-CTA -->
  <section class="section" aria-labelledby="cta-tittel">
    <div class="container">
      <div class="cta reveal">
        <div class="cta__text">
          <h2 id="cta-tittel" class="h1">Har du et prosjekt på gang?</h2>
          <p class="body-lg muted">Fortell kort hva du trenger, så kommer vi tilbake med forslag og pris.</p>
        </div>
        <div class="cta__actions">
          <a class="ov-btn ov-btn--primary" href="/kontakt">Book en prat</a>
          <p class="body">
            <a href="tel:+4794247771">+47 942 47 771</a><br /><a href="mailto:post@ostmoenvisuals.com">post@ostmoenvisuals.com</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .section-title { max-width: 18ch; margin-bottom: var(--space-8); }
  @media (min-width: 900px) { .section-title { margin-bottom: var(--space-12); } }
  .section-head__text { display: flex; flex-direction: column; gap: var(--space-3); }
  .section-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); margin-bottom: var(--space-8); }

  /* Hero */
  .section--hero { padding-top: var(--space-6); }
  @media (min-width: 900px) { .section--hero { padding-top: var(--space-12); } }
  .hero { display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 900px) { .hero { grid-template-columns: 5fr 6fr; gap: var(--space-14); } }
  .hero__text { display: flex; flex-direction: column; gap: var(--space-6); align-items: flex-start; }
  .hero__text .body-lg { max-width: 52ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .hero__media { position: relative; border-radius: var(--radius-lg); overflow: hidden; background: var(--surface-raised); aspect-ratio: 5 / 4; }
  .hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hero__chip { position: absolute; left: var(--space-4); bottom: var(--space-4); }

  /* Kunder */
  .kunder__inner { display: flex; flex-direction: column; gap: var(--space-4); padding-block: var(--space-8); border-block: 1px solid var(--line); }
  .kunder__list { display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-8); color: var(--ink-muted); }
  @media (min-width: 900px) { .kunder__inner { flex-direction: row; gap: var(--space-12); } .kunder__inner h2 { flex: 0 0 180px; padding-top: 5px; } }

  /* Tjenester */
  .tjenester { display: grid; gap: var(--space-4); }
  @media (min-width: 900px) { .tjenester { grid-template-columns: repeat(3, 1fr); gap: var(--space-6); } }
  .tjeneste { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); background: var(--surface-raised); border-radius: var(--radius-md); padding: var(--space-8); }
  .tjeneste .text-link { margin-top: auto; }

  /* Prosjekter */
  .prosjekter { display: grid; gap: var(--space-8) var(--space-6); }
  @media (min-width: 700px) { .prosjekter { grid-template-columns: repeat(2, 1fr); } }

  /* Showreel */
  .showreel { display: flex; flex-direction: column; gap: var(--space-8); }
  .showreel__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-6); }
  .showreel__head h2 { max-width: 20ch; }

  /* Om oss */
  .omoss { display: grid; gap: var(--space-8); align-items: center; }
  @media (min-width: 900px) { .omoss { grid-template-columns: 4fr 5fr; gap: var(--space-24); } }
  .omoss__media { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; background: var(--surface-raised); max-width: 520px; }
  .omoss__media :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .omoss__text { display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
  .omoss__text .body-lg { max-width: 48ch; }

  /* Sitater */
  .sitater-seksjon__inner { display: flex; flex-direction: column; gap: var(--space-8); }
  .sitater { display: grid; gap: var(--space-8); }
  .sitater blockquote { font-size: 17px; line-height: 26px; }
  @media (min-width: 900px) { .sitater { grid-template-columns: repeat(3, 1fr); gap: var(--space-12); } }
  .sitater figure { padding-top: var(--space-4); border-top: 1px solid var(--line-strong); display: flex; flex-direction: column; gap: var(--space-4); }

  /* CTA */
  .cta__text { display: flex; flex-direction: column; gap: var(--space-4); max-width: 640px; }
  .cta__actions { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-4); }
  @media (min-width: 900px) { .cta { flex-direction: row !important; align-items: center !important; justify-content: space-between; } }
  .cta { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-6); background: var(--surface-raised); border-radius: var(--radius-xl); padding: var(--space-8); }
  @media (min-width: 900px) { .cta { padding: var(--space-14); } }
  .cta a:not(.ov-btn) { text-decoration: none; }
  .cta a:not(.ov-btn):hover { color: var(--accent); }
</style>
